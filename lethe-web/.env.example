# Copy this file to `.env.local` and fill in your Supabase project values.
# Supabase dashboard -> Project Settings -> API Keys.
# Use the PUBLISHABLE key only. Never put a secret / service_role key in a frontend.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Developer-only portal preview (works only with `npm run dev`, never in a build).
# Lets you render a portal as one of the seeded identities without signing in.
# VITE_DEV_PREVIEW=true
